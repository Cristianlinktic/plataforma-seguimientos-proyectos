# Copia este archivo a .env y completa los valores.
# En Supabase: Project Settings > Database > Connection string.

# Conexión pooled (puerto 6543, vía Supavisor) — la usa la app en runtime.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión directa (puerto 5432, sin pooler) — la usa Prisma Migrate/CLI.
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# Genera con: openssl rand -base64 32
AUTH_SECRET="reemplaza-esto-con-un-valor-aleatorio-de-32-bytes"

# Usados solo por prisma/seed.ts para crear el primer usuario administrador.
SEED_ADMIN_NAME="Fabian Peralta"
SEED_ADMIN_EMAIL="fabian.peralta@linktic.com"
SEED_ADMIN_PASSWORD="cambia-esta-clave-antes-de-hacer-seed"
