# Copia este archivo a .env y completa los valores.
# En Supabase: Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key"

# Service Role key: acceso total server-side, se salta Row Level Security.
# NUNCA debe llevar el prefijo NEXT_PUBLIC_ ni usarse en el navegador.
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"

# Genera con: openssl rand -base64 32
AUTH_SECRET="reemplaza-esto-con-un-valor-aleatorio-de-32-bytes"

# Usados solo por scripts/seed.ts para crear el primer usuario administrador.
SEED_ADMIN_NAME="Fabian Peralta"
SEED_ADMIN_EMAIL="fabian.peralta@linktic.com"
SEED_ADMIN_PASSWORD="cambia-esta-clave-antes-de-hacer-seed"
