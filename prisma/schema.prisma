generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Los nombres físicos de tabla/enum llevan el sufijo _seguimiento para no
// confundirse con otras tablas que puedan existir en el mismo proyecto de
// Supabase. Los modelos de Prisma (y por tanto el resto del código) siguen
// llamándose User/Proyecto/Frente/Actividad sin cambios.
enum EstadoActividad {
  PENDIENTE
  EN_CURSO
  CERRADA

  @@map("EstadoActividad_seguimiento")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("User_seguimiento")
}

model Proyecto {
  id          String      @id @default(cuid())
  nombre      String
  descripcion String?
  faseActual  String?
  fechaCorte  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  frentes     Frente[]
  actividades Actividad[]

  @@map("Proyecto_seguimiento")
}

model Frente {
  id         String      @id @default(cuid())
  nombre     String
  orden      Int         @default(0)
  proyectoId String
  proyecto   Proyecto    @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  actividades Actividad[]

  @@unique([proyectoId, nombre])
  @@map("Frente_seguimiento")
}

model Actividad {
  id          String          @id @default(cuid())
  numero      Int
  nombre      String
  responsable String
  estado      EstadoActividad @default(PENDIENTE)
  porcentaje  Int             @default(0)
  fechaInicio DateTime
  fechaFin    DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  proyectoId String
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  frenteId String?
  frente   Frente? @relation(fields: [frenteId], references: [id], onDelete: SetNull)

  @@index([proyectoId])
  @@index([frenteId])
  @@map("Actividad_seguimiento")
}
